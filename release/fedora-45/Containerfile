# SilentSnake release build container: Fedora 45 (docs/decisions/0002).
# Minimal by design: compiler, libpcap headers and the pinned stable Rust only. Security tooling
# (syft, cosign, audits) runs in the dev container, never here.
# Base digest and Rust pins are the ones already approved for dev/Containerfile (2026-11-25).
FROM registry.fedoraproject.org/fedora:45@sha256:92837d4834c1cff45cc2d534b655489b8e536271de1897932117e396cc9980c5

# Exact RPM versions can't be pinned on Fedora; the installed set is recorded and shipped in
# the release tarball as BUILD-ENV.rpm.lock.
RUN dnf -y install --setopt=install_weak_deps=False gcc pkgconf-pkg-config libpcap-devel \
 && dnf clean all \
 && rpm -qa --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /etc/silentsnake-build-env.lock

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -fsSLo /tmp/rustup-init https://static.rust-lang.org/rustup/archive/1.29.3/x86_64-unknown-linux-gnu/rustup-init \
 && echo "b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55  /tmp/rustup-init" | sha256sum -c - \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain 1.99.0 \
 && rm /tmp/rustup-init

RUN useradd -m -u 1000 builder && mkdir -p /work && chown builder:builder /work
USER builder
# Same 1.99.0 as rust-toolchain.toml, set explicitly so rustup doesn't try to add that file's
# dev-only components (clippy, rustfmt) to this read-only, build-only toolchain.
ENV CARGO_HOME=/home/builder/.cargo-cache RUSTUP_TOOLCHAIN=1.99.0
WORKDIR /work
